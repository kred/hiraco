{
  "name": "hiraco-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser UI for hiraco: Linear DNG conversion entirely in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
